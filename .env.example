# Copy to .env. Nothing here is secret: the default setup needs no API keys.

# ollama = local model through Ollama (free). mock = rule-based diagnoser, no model at all.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen3:8b
# Outside Docker this is http://localhost:11434/v1
OLLAMA_URL=http://host.docker.internal:11434/v1

# Optional: price per million tokens, to estimate what a paid model would cost in eval reports.
PRICE_PER_M_INPUT=0
PRICE_PER_M_OUTPUT=0

SIM_SEED=1
SIM_TICK_MS=1000
